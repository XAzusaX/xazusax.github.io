---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  getLocaleFromPath,
  localeInfo,
} from "../i18n/config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Reverie Archive — Azusa",
  description = "Azusa's personal notes, projects, and creative archive.",
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const htmlLang = localeInfo[locale].htmlLang;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <div class="ambient" aria-hidden="true">
      <span class="glow glow-one"></span>
      <span class="glow glow-two"></span>
      <span class="glow glow-three"></span>
    </div>

    <Header />

    <slot />

    <Footer />
  </body>
</html>