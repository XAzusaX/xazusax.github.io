---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Login — Reverie Archive" description="Reverie Archive Studio 登入頁面。">
  <main class="studio-login-page">
    <section class="studio-login">
      <div class="studio-login-intro">
        <p class="eyebrow">Archive Studio · Private access</p>

        <h1>回到<br />檔案館。</h1>

        <p>
          這裡是 Archive 的私人工作區。
          登入後可以建立草稿、整理文章與發布內容。
        </p>

        <div class="studio-login-record" aria-label="系統狀態">
          <span>WRITER ACCESS</span>
          <strong>RESTRICTED</strong>
        </div>
      </div>

      <div class="studio-login-form-area">
        <p class="eyebrow">身份驗證</p>
        <h2>登入 Studio</h2>

        <form class="studio-form" data-login-form novalidate>
          <div class="form-field">
            <label for="email">電子郵件</label>

            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
              aria-describedby="email-error"
            />

            <p
              class="field-message"
              id="email-error"
              data-email-error
              aria-live="polite"
              hidden
            ></p>
          </div>

          <div class="form-field">
            <label for="password">密碼</label>

            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="輸入密碼"
              required
              aria-describedby="password-error"
            />

            <p
              class="field-message"
              id="password-error"
              data-password-error
              aria-live="polite"
              hidden
            ></p>
          </div>

          <button type="submit">
            登入並進入 Studio <span>→</span>
          </button>

          <p class="form-message" data-form-message aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <script>
    import { supabase } from "../../lib/supabase";

    const form = document.querySelector<HTMLFormElement>("[data-login-form]");
    const message =
      document.querySelector<HTMLParagraphElement>("[data-form-message]");
    const button = form?.querySelector<HTMLButtonElement>("button");

    const emailInput =
      document.querySelector<HTMLInputElement>("#email");

    const passwordInput =
      document.querySelector<HTMLInputElement>("#password");

    const emailError =
      document.querySelector<HTMLParagraphElement>("[data-email-error]");

    const passwordError =
      document.querySelector<HTMLParagraphElement>("[data-password-error]");

    const setFieldError = (
      input: HTMLInputElement | null,
      error: HTMLParagraphElement | null,
      text: string,
    ) => {
      if (!input || !error) return;

      input.setAttribute("aria-invalid", String(Boolean(text)));
      error.textContent = text;
      error.hidden = !text;
    };

    const resetButton = () => {
      if (!button) return;

      button.disabled = false;
      button.innerHTML = "登入並進入 Studio <span>→</span>";
    };

    emailInput?.addEventListener("input", () => {
      setFieldError(emailInput, emailError, "");
    });

    passwordInput?.addEventListener("input", () => {
      setFieldError(passwordInput, passwordError, "");
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const email = emailInput?.value.trim() ?? "";
      const password = passwordInput?.value ?? "";

      setFieldError(emailInput, emailError, "");
      setFieldError(passwordInput, passwordError, "");

      if (message) {
        message.textContent = "";
      }

      let hasError = false;

      if (!email) {
        setFieldError(emailInput, emailError, "請輸入電子郵件地址。");
        hasError = true;
      } else if (emailInput?.validity.typeMismatch) {
        setFieldError(emailInput, emailError, "請輸入有效的電子郵件格式。");
        hasError = true;
      }

      if (!password) {
        setFieldError(passwordInput, passwordError, "請輸入密碼。");
        hasError = true;
      }

      if (hasError || !button) return;

      button.disabled = true;
      button.textContent = "正在驗證…";

      const { error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        if (message) {
          message.textContent = "登入失敗，請確認電子郵件與密碼是否正確。";
        }

        resetButton();
        return;
      }

      window.location.assign("/studio");
    });
  </script>
</BaseLayout>