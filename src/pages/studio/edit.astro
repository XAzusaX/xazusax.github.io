---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="編輯文章 — Archive Studio" description="編輯 Archive 文章。">
  <main class="editor-page">
    <header class="editor-header">
      <div>
        <a class="editor-back" href="/studio">← 返回 Studio</a>
        <p class="eyebrow">Archive Studio · Edit record</p>
        <h1>編輯文章</h1>
      </div>

      <p class="editor-status" data-editor-status>正在載入文章…</p>
    </header>

    <form class="post-editor" data-post-form hidden>
      <section class="editor-section">
        <label for="title">標題</label>
        <input id="title" name="title" type="text" maxlength="160" required />
      </section>

      <section class="editor-section">
        <label for="description">摘要</label>
        <textarea
          id="description"
          name="description"
          rows="3"
          maxlength="300"
          required
        ></textarea>
      </section>

      <section class="editor-grid">
        <div class="editor-section">
          <label for="slug">網址代號</label>
          <input
            id="slug"
            name="slug"
            type="text"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            required
          />
          <p class="editor-hint">只用英文小寫、數字和連字號。</p>
        </div>

        <div class="editor-section">
          <label for="tags">標籤</label>
          <input id="tags" name="tags" type="text" />
          <p class="editor-hint">用逗號分隔多個標籤。</p>
        </div>
      </section>

      <section class="editor-section">
        <label for="content">正文</label>
        <textarea
          class="editor-content"
          id="content"
          name="content"
          rows="18"
          required
        ></textarea>
      </section>

      <div class="editor-actions">
        <p class="editor-message" data-editor-message aria-live="polite"></p>

        <div class="editor-button-group">
          <button class="editor-delete" type="button" data-delete>
            刪除文章
          </button>
          <button class="editor-save" type="submit" value="draft">
            儲存為草稿
          </button>
          <button class="editor-publish" type="submit" value="published">
            發布文章 <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </form>

    <p class="studio-empty" data-load-error hidden></p>
  </main>

  <script>
    import { supabase } from "../../../lib/supabase";

    type Post = {
      id: string;
      title: string;
      description: string;
      slug: string;
      content: string;
      tags: string[];
      status: "draft" | "published";
      published_at: string | null;
    };

    const form = document.querySelector<HTMLFormElement>("[data-post-form]");
    const status = document.querySelector<HTMLParagraphElement>(
      "[data-editor-status]"
    );
    const message = document.querySelector<HTMLParagraphElement>(
      "[data-editor-message]"
    );
    const loadError = document.querySelector<HTMLParagraphElement>(
      "[data-load-error]"
    );
    const deleteButton =
      document.querySelector<HTMLButtonElement>("[data-delete]");
    const buttons = form?.querySelectorAll<HTMLButtonElement>("button");

    const id = new URLSearchParams(window.location.search).get("id");
    const slugPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
    let currentPost: Post | null = null;

    const showLoadError = (text: string) => {
      if (status) status.textContent = "無法開啟文章";
      if (loadError) {
        loadError.textContent = text;
        loadError.hidden = false;
      }
    };

    const fillForm = (post: Post) => {
      const fields = {
        title: post.title,
        description: post.description,
        slug: post.slug,
        tags: post.tags.join(", "),
        content: post.content,
      };

      Object.entries(fields).forEach(([name, value]) => {
        const field = form?.elements.namedItem(name);

        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        ) {
          field.value = value;
        }
      });

      if (status) {
        status.textContent =
          post.status === "published" ? "目前已發布" : "目前是草稿";
      }

      form?.removeAttribute("hidden");
    };

    const loadPost = async () => {
      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) {
        window.location.replace("/login");
        return;
      }

      if (!id) {
        showLoadError("找不到文章識別碼。請從 Studio 的文章列表重新開啟。");
        return;
      }

      const { data, error } = await supabase
        .from("posts")
        .select("id, title, description, slug, content, tags, status, published_at")
        .eq("id", id)
        .single();

      if (error || !data) {
        showLoadError("找不到這篇文章，或你沒有存取權限。");
        return;
      }

      currentPost = data as Post;
      fillForm(currentPost);
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!currentPost) return;

      const submitter = event.submitter as HTMLButtonElement | null;
      const action = submitter?.value === "published" ? "published" : "draft";
      const formData = new FormData(form);

      const title = String(formData.get("title") || "").trim();
      const description = String(formData.get("description") || "").trim();
      const slug = String(formData.get("slug") || "").trim().toLowerCase();
      const content = String(formData.get("content") || "").trim();
      const tags = String(formData.get("tags") || "")
        .split(/[,，]/)
        .map((tag) => tag.trim())
        .filter(Boolean);

      if (!slugPattern.test(slug)) {
        if (message) {
          message.textContent = "網址代號只能使用英文小寫、數字和連字號。";
        }
        return;
      }

      buttons?.forEach((button) => (button.disabled = true));

      if (message) {
        message.textContent =
          action === "published" ? "正在發布文章…" : "正在儲存草稿…";
      }

      const { error } = await supabase
        .from("posts")
        .update({
          title,
          description,
          slug,
          content,
          tags,
          status: action,
          published_at:
            action === "published"
              ? currentPost.published_at || new Date().toISOString()
              : null,
        })
        .eq("id", currentPost.id);

      if (error) {
        if (message) {
          message.textContent =
            error.code === "23505"
              ? "這個網址代號已被使用，請換一個。"
              : `無法儲存文章：${error.message}`;
        }

        buttons?.forEach((button) => (button.disabled = false));
        return;
      }

      window.location.assign("/studio");
    });

    deleteButton?.addEventListener("click", async () => {
      if (!currentPost) return;

      const confirmed = window.confirm(
        `確定要刪除〈${currentPost.title}〉嗎？此動作無法復原。`
      );

      if (!confirmed) return;

      deleteButton.disabled = true;

      const { error } = await supabase
        .from("posts")
        .delete()
        .eq("id", currentPost.id);

      if (error) {
        if (message) message.textContent = `無法刪除文章：${error.message}`;
        deleteButton.disabled = false;
        return;
      }

      window.location.assign("/studio");
    });

    loadPost();
  </script>
</BaseLayout>