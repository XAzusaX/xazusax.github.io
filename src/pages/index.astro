---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reverie Archive — Azusa"
  description="Azusa 的個人筆記、專案與創作收藏。"
>
  <main>
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow reveal" style="--delay: 100ms">
          個人檔案館 · 2026
        </p>

        <h1 class="reveal" id="home-title" style="--delay: 220ms">
          你好，我是<br />Azusa。
        </h1>

        <p class="hero-description reveal" style="--delay: 360ms">
          這裡放著我的筆記、專案、故事，
          還有其他暫時找不到分類的東西。
        </p>

        <a class="hero-link reveal" href="#collections" style="--delay: 500ms">
          開始瀏覽 <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div
        class="hero-artefact reveal"
        style="--delay: 300ms"
        aria-label="Archive 首頁視覺"
      >
        <div class="artefact-topline">
          <span>REVERIE ARCHIVE</span>
          <span>1113</span>
        </div>

        <div class="artefact-orbit">
          <span class="orbit-ring orbit-ring-one"></span>
          <span class="orbit-ring orbit-ring-two"></span>
          <span class="orbit-core">A</span>
        </div>

        <div class="artefact-bottom">
          <span>PERSONAL INDEX</span>
          <span>STATUS: ONLINE</span>
        </div>
      </div>
    </section>

    <section class="collections" id="collections" aria-labelledby="collections-title">
      <div class="section-intro scroll-reveal">
        <p class="eyebrow">收藏分類</p>
        <h2 id="collections-title">從這裡開始。</h2>
      </div>

      <div class="archive-grid">
        <a class="archive-card scroll-reveal" id="journal" href="/journal" style="--delay: 0ms">
          <span class="card-number">01</span>
          <span class="card-arrow" aria-hidden="true">↗</span>

          <div>
            <h3>隨筆</h3>
            <p>學習、生活、遊戲與開發過程中的記錄。</p>
          </div>
        </a>

        <a class="archive-card scroll-reveal" id="projects" href="/projects" style="--delay: 100ms">
          <span class="card-number">02</span>
          <span class="card-arrow" aria-hidden="true">↗</span>

          <div>
            <h3>專案</h3>
            <p>網站、工具、實驗，以及想繼續完善的作品。</p>
          </div>
        </a>
      </div>
    </section>
  </main>

  <script>
    const scrollElements = document.querySelectorAll(".scroll-reveal");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.18,
        rootMargin: "0px 0px -8% 0px",
      },
    );

    scrollElements.forEach((element) => observer.observe(element));
  </script>
</BaseLayout>