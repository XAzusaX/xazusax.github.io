---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="找不到這份檔案 — Reverie Archive"
  description="這個頁面不存在，或已被移至其他位置。"
>
  <main class="not-found-page">
    <section class="not-found-record">
      <div class="not-found-copy">
        <p class="eyebrow">ARCHIVE NOTICE · 404</p>

        <h1>
          這份檔案<br />
          不在館內。
        </h1>

        <p>
          你要找的頁面可能不存在、已被移動，
          或網址中有一個小小的錯字。
        </p>

        <div class="not-found-actions">
          <a class="not-found-primary" href="/">
            返回首頁 <span aria-hidden="true">→</span>
          </a>

          <a class="not-found-secondary" href="/projects">
            查看專案
          </a>
        </div>
      </div>

      <div class="not-found-index" aria-label="檔案索引狀態">
        <div class="not-found-index-top">
          <span>REVERIE ARCHIVE</span>
          <span>404</span>
        </div>

        <div class="not-found-index-mark" aria-hidden="true">
          <span>?</span>
        </div>

        <div class="not-found-index-bottom">
          <span>RECORD NOT FOUND</span>
          <span>STATUS: OFFLINE</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>