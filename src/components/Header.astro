<header class="site-header" data-site-header>
  <a class="wordmark" href="/" aria-label="Archive 首頁">
    <span class="wordmark-mark" aria-hidden="true">A</span>

    <span class="wordmark-copy">
      <strong>Archive</strong>
      <small>個人收藏</small>
    </span>
  </a>

  <div class="header-tools">
    <div class="header-account" data-account>
      <a class="header-login" href="/login" data-login-link>Login</a>

      <details class="account-menu" data-account-menu hidden>
        <summary aria-label="開啟帳號選單">
          <span class="account-avatar" data-account-avatar>A</span>
          <span class="account-name" data-account-name>Archive</span>
        </summary>

        <div class="account-dropdown">
          <p data-account-email></p>
          <a href="/studio">進入 Studio →</a>
          <button type="button" data-sign-out>登出</button>
        </div>
      </details>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-label="打開選單"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="site-menu" id="site-menu" aria-label="網站導覽" data-site-menu>
    <ul class="menu-list">
      <li>
        <a href="/journal">隨筆</a>
      </li>

      <li class="menu-item-with-children">
        <button
          class="submenu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="projects-submenu"
        >
          專案
          <span aria-hidden="true">›</span>
        </button>

        <ul class="submenu" id="projects-submenu">
          <li><a href="#projects">所有專案</a></li>
          <li><a href="#elements">元素探索者</a></li>
          <li><a href="#projects">網站與實驗</a></li>
        </ul>
      </li>

      <li class="menu-item-with-children">
        <button
          class="submenu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="archive-submenu"
        >
          Archive
          <span aria-hidden="true">›</span>
        </button>

        <ul class="submenu" id="archive-submenu">
          <li><a href="#archive">小說與世界觀</a></li>
          <li><a href="#archive">舊版收藏</a></li>
        </ul>
      </li>

      <li>
        <a href="#about">關於</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { supabase } from "../../lib/supabase";

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const menuToggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const siteMenu = document.querySelector<HTMLElement>("[data-site-menu]");
  const submenuToggles =
    document.querySelectorAll<HTMLButtonElement>(".submenu-toggle");

  const loginLink =
    document.querySelector<HTMLAnchorElement>("[data-login-link]");
  const accountMenu =
    document.querySelector<HTMLDetailsElement>("[data-account-menu]");
  const avatar =
    document.querySelector<HTMLSpanElement>("[data-account-avatar]");
  const name =
    document.querySelector<HTMLSpanElement>("[data-account-name]");
  const email =
    document.querySelector<HTMLParagraphElement>("[data-account-email]");
  const signOutButton =
    document.querySelector<HTMLButtonElement>("[data-sign-out]");

  const closeSubmenus = () => {
    submenuToggles.forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
  };

  const closeMenu = () => {
    if (!menuToggle || !siteMenu) return;

    menuToggle.setAttribute("aria-expanded", "false");
    menuToggle.setAttribute("aria-label", "打開選單");
    siteMenu.classList.remove("is-open");
    closeSubmenus();
  };

  menuToggle?.addEventListener("click", () => {
    if (!siteMenu) return;

    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";

    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "打開選單" : "關閉選單");
    siteMenu.classList.toggle("is-open", !isOpen);

    if (isOpen) closeSubmenus();
  });

  submenuToggles.forEach((button) => {
    button.addEventListener("click", () => {
      const isOpen = button.getAttribute("aria-expanded") === "true";

      submenuToggles.forEach((otherButton) => {
        otherButton.setAttribute("aria-expanded", "false");
      });

      button.setAttribute("aria-expanded", String(!isOpen));
    });
  });

  document.addEventListener("click", (event) => {
    if (!header || !(event.target instanceof Node)) return;

    if (!header.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  siteMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  const renderAccount = (user: {
    email?: string;
    user_metadata?: Record<string, unknown>;
  } | null) => {
    if (!loginLink || !accountMenu || !avatar || !name || !email) return;

    if (!user) {
      loginLink.hidden = false;
      accountMenu.hidden = true;
      accountMenu.open = false;
      return;
    }

    const metadata = user.user_metadata ?? {};
    const displayName =
      String(metadata.full_name || metadata.name || "").trim() ||
      user.email?.split("@")[0] ||
      "Writer";

    loginLink.hidden = true;
    accountMenu.hidden = false;
    avatar.textContent = displayName.slice(0, 1).toUpperCase();
    name.textContent = displayName;
    email.textContent = user.email ?? "";
  };

  const loadAccount = async () => {
    const {
      data: { user },
    } = await supabase.auth.getUser();

    renderAccount(user);
  };

  supabase.auth.onAuthStateChange((_event, session) => {
    renderAccount(session?.user ?? null);
  });

  signOutButton?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.assign("/");
  });

  loadAccount();
</script>