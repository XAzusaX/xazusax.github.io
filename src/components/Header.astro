---
import { siteIdentity } from "../config/site";
import {
  getLocaleFromPath,
  locales,
  localizePath,
  removeLocaleFromPath,
  type Locale,
} from "../i18n/config";
import { headerCopy } from "../i18n/header";

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = headerCopy[locale];

const canonicalPath = removeLocaleFromPath(Astro.url.pathname);

const languageCodes: Record<Locale, string> = {
  en: "EN",
  "zh-Hant": "繁",
  "zh-Hans": "简",
  ja: "日",
};

const languageHref = (targetLocale: Locale) =>
  `${localizePath(targetLocale, canonicalPath)}${Astro.url.search}`;
---

<header
  class="site-header"
  data-site-header
  data-locale={locale}
  data-owner-display-name={siteIdentity.ownerDisplayName}
>
  <div class="header-brand">
    <button
      class="menu-toggle"
      type="button"
      aria-label={copy.openMenu}
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="wordmark" href={localizePath(locale, "/")} aria-label={copy.homeAria}>
      <span class="wordmark-mark">
        <img
          class="wordmark-image"
          src={siteIdentity.assets.siteLogo}
          alt=""
          data-site-logo
        />
        <span class="wordmark-fallback" aria-hidden="true">A</span>
      </span>

      <span class="wordmark-copy">
        <strong>{siteIdentity.siteName}</strong>
        <small>{copy.siteSubtitle}</small>
      </span>
    </a>
  </div>
  
  <div class="header-tools">
    <div class="header-language">
      <details class="language-menu" data-language-menu>
        <summary class="language-trigger" aria-label={copy.language}>
          <span class="language-code">{languageCodes[locale]}</span>
          <svg
            class="language-caret"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path d="m7 10 5 5 5-5" />
          </svg>
        </summary>

        <div class="language-dropdown">
          {
            locales.map((targetLocale) => (
              <a
                href={languageHref(targetLocale)}
                aria-current={
                  targetLocale === locale ? "true" : undefined
                }
              >
                {copy.languages[targetLocale]}
              </a>
            ))
          }
        </div>
      </details>
    </div>
    <div class="header-account" data-account>
      <a
        class="login-link"
        href={localizePath(locale, "/login")}
        data-login-link
        hidden
      >
        {copy.login}
      </a>

<details class="account-menu" data-account-menu hidden>
  <summary class="account-trigger">
    <span class="account-avatar">
      <img
        src={siteIdentity.assets.ownerAvatar}
        alt=""
        width="44"
        height="44"
        data-account-avatar-image
      />

      <span
        class="account-avatar-fallback"
        aria-hidden="true"
        data-account-avatar-fallback
      >
        A
      </span>
    </span>

    <span class="account-name" data-account-name>
      {siteIdentity.ownerDisplayName}
    </span>

    <span class="account-caret" aria-hidden="true"></span>
  </summary>

  <div class="account-dropdown">
    <p data-account-email>{copy.accountLoading}</p>

    <a href={localizePath(locale, "/studio")}>
      {copy.studio} <span aria-hidden="true">→</span>
    </a>

    <button type="button" data-sign-out>
      {copy.signOut}
    </button>
    </div>
</details>
</div>
</div>
</header>

<button
  class="menu-backdrop"
  type="button"
  aria-label={copy.closeMenu}
  data-menu-backdrop
  hidden
></button>

<nav
  class="site-menu"
  id="site-menu"
  aria-label={copy.navigation}
  aria-hidden="true"
  data-site-menu
>


  <ul class="menu-list">
  <li>
    <a href={localizePath(locale, "/journal")}>
      {copy.journal}
    </a>
  </li>

  <li class="menu-item-with-children">
    <button
      class="submenu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="projects-submenu"
    >
      {copy.projects}
      <span aria-hidden="true">›</span>
    </button>

    <ul class="submenu" id="projects-submenu">
      <li>
        <a href={localizePath(locale, "/projects")}>
          {copy.allProjects}
        </a>
      </li>

      <li>
        <a href={localizePath(locale, "/projects/elements")}>
          {copy.elementExplorer}
        </a>
      </li>
    </ul>
  </li>

  <li>
    <a href={localizePath(locale, "/about")}>
      {copy.about}
    </a>
  </li>
</ul>
</nav>

<script>
  import { supabase } from "../../lib/supabase";
  import {
    localizePath,
    type Locale,
  } from "../i18n/config";
  import { headerCopy } from "../i18n/header";

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const locale = (header?.dataset.locale ?? "en") as Locale;
  const copy = headerCopy[locale];
  const homePath = localizePath(locale, "/");

  const languageMenu =
    document.querySelector<HTMLDetailsElement>("[data-language-menu]");
  const ownerDisplayName =
    header?.dataset.ownerDisplayName?.trim() || "Archive";

  const menuToggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");

  const menuBackdrop =
    document.querySelector<HTMLButtonElement>("[data-menu-backdrop]");

  const siteMenu =
    document.querySelector<HTMLElement>("[data-site-menu]");

  const submenuToggles =
    document.querySelectorAll<HTMLButtonElement>(".submenu-toggle");

  const loginLink =
    document.querySelector<HTMLAnchorElement>("[data-login-link]");

  const accountMenu =
    document.querySelector<HTMLDetailsElement>("[data-account-menu]");

  const avatarFallback =
    document.querySelector<HTMLElement>("[data-account-avatar-fallback]");

  const accountAvatarImage =
    document.querySelector<HTMLImageElement>(
      "[data-account-avatar-image]"
    );

  const siteLogo =
    document.querySelector<HTMLImageElement>("[data-site-logo]");

  const name =
    document.querySelector<HTMLSpanElement>("[data-account-name]");

  const email =
    document.querySelector<HTMLParagraphElement>("[data-account-email]");

  const signOutButton =
    document.querySelector<HTMLButtonElement>("[data-sign-out]");

  const accountTrigger =
  accountMenu?.querySelector<HTMLElement>(".account-trigger");

let accountCloseTimer: number | undefined;

const closeAccount = () => {
  if (!accountMenu?.open) return;

  window.clearTimeout(accountCloseTimer);

  accountMenu.classList.add("is-closing");

  accountCloseTimer = window.setTimeout(() => {
    accountMenu.open = false;
    accountMenu.classList.remove("is-closing");
  }, 240);
};

const openAccount = () => {
  if (!accountMenu) return;

  window.clearTimeout(accountCloseTimer);
  accountMenu.classList.remove("is-closing");
  accountMenu.open = true;
};

accountTrigger?.addEventListener("click", (event) => {
  event.preventDefault();

  if (accountMenu?.open) {
    closeAccount();
  } else {
    openAccount();
  }
});
const languageTrigger =
  languageMenu?.querySelector<HTMLElement>(".language-trigger");

let languageCloseTimer: number | undefined;

const closeLanguage = () => {
  if (!languageMenu?.open) return;

  window.clearTimeout(languageCloseTimer);
  languageMenu.classList.add("is-closing");

  languageCloseTimer = window.setTimeout(() => {
    languageMenu.open = false;
    languageMenu.classList.remove("is-closing");
  }, 240);
};

const openLanguage = () => {
  if (!languageMenu) return;

  window.clearTimeout(languageCloseTimer);
  languageMenu.classList.remove("is-closing");
  languageMenu.open = true;
};

languageTrigger?.addEventListener("click", (event) => {
  event.preventDefault();

  if (languageMenu?.open) {
    closeLanguage();
  } else {
    closeAccount();
    openLanguage();
  }
});

  const closeSubmenus = () => {
    submenuToggles.forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
  };

  const setMenu = (isOpen: boolean) => {
    if (!menuToggle || !siteMenu || !menuBackdrop) return;

    menuToggle.setAttribute("aria-expanded", String(isOpen));
    menuToggle.setAttribute(
      "aria-label",
      isOpen ? copy.closeMenu : copy.openMenu
    );

    siteMenu.classList.toggle("is-open", isOpen);
    siteMenu.setAttribute("aria-hidden", String(!isOpen));

    menuBackdrop.hidden = !isOpen;
    menuBackdrop.classList.toggle("is-open", isOpen);

    document.body.classList.toggle("menu-is-open", isOpen);

    if (isOpen) {
      closeAccount();
    } else {
      closeSubmenus();
      menuToggle.focus();
    }
  };

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    setMenu(!isOpen);
  });

  menuBackdrop?.addEventListener("click", () => setMenu(false));

  submenuToggles.forEach((button) => {
    button.addEventListener("click", () => {
      const isOpen =
        button.getAttribute("aria-expanded") === "true";

      submenuToggles.forEach((otherButton) => {
        otherButton.setAttribute("aria-expanded", "false");
      });

      button.setAttribute("aria-expanded", String(!isOpen));
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    if (accountMenu?.open) {
      closeAccount();
    }
    if (languageMenu?.open) {
      closeLanguage();
    }
    setMenu(false);
  });

  siteMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  accountMenu?.addEventListener("toggle", () => {
    if (accountMenu.open) {
      setMenu(false);
    }
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;

    if (accountMenu?.open && !accountMenu.contains(event.target)) {
      closeAccount();
    }
    if (languageMenu?.open && !languageMenu.contains(event.target)) {
      closeLanguage();
    }
  });

 const renderAccount = (user: { email?: string } | null) => {
  const isSignedIn = Boolean(user);

  /* 不讓任何舊 CSS 覆蓋登入／帳戶的顯示狀態 */
  if (loginLink) {
    loginLink.hidden = isSignedIn;
    loginLink.style.setProperty(
      "display",
      isSignedIn ? "none" : "inline-flex",
      "important"
    );
  }

  if (accountMenu) {
    accountMenu.hidden = !isSignedIn;
    accountMenu.style.setProperty(
      "display",
      isSignedIn ? "flex" : "none",
      "important"
    );

    if (!isSignedIn) {
      accountMenu.open = false;
    }
  }

  /* 未登入時不用繼續填寫帳戶資料 */
  if (!user) return;

  if (avatarFallback) {
    avatarFallback.textContent = ownerDisplayName
      .slice(0, 1)
      .toUpperCase();
  }

  if (name) {
    name.textContent = ownerDisplayName;
  }

  if (email) {
    email.textContent = user.email ?? "";
  }
};


  accountAvatarImage?.addEventListener("error", () => {
    accountAvatarImage.hidden = true;
  });

  siteLogo?.addEventListener("error", () => {
    siteLogo.hidden = true;
  });

  signOutButton?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.assign(homePath);
  });

  const loadAccount = async () => {
    const {
      data: { user },
    } = await supabase.auth.getUser();

    renderAccount(user);
  };

  supabase.auth.onAuthStateChange((_event, session) => {
    renderAccount(session?.user ?? null);
  });

  loadAccount();
</script>