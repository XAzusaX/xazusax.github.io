---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizePath, type Locale } from "../i18n/config";
import { studioCopy } from "../i18n/studio";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = studioCopy[locale];

const studioPath = localizePath(locale, "/studio");
---

<BaseLayout title={copy.editTitle} description={copy.editDescription}>
  <main class="editor-page" data-studio-edit-page data-locale={locale}>
    <header class="editor-header">
      <div>
        <a class="editor-back" href={studioPath}>{copy.backToStudio}</a>
        <p class="eyebrow">{copy.editEyebrow}</p>
        <h1>{copy.editHeading}</h1>
      </div>

      <p class="editor-status" data-editor-status>{copy.loadingPost}</p>
    </header>

    <form class="post-editor" data-post-form hidden>
      <section class="editor-section">
        <label for="title">{copy.titleLabel}</label>
        <input id="title" name="title" type="text" maxlength="160" required />
      </section>

      <section class="editor-section">
        <label for="description">{copy.descriptionLabel}</label>
        <textarea
          id="description"
          name="description"
          rows="3"
          maxlength="300"
          required
        ></textarea>
      </section>

      <section class="editor-grid">
        <div class="editor-section">
          <label for="slug">{copy.slugLabel}</label>
          <input
            id="slug"
            name="slug"
            type="text"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            required
          />
          <p class="editor-hint">{copy.slugHint}</p>
        </div>

        <div class="editor-section">
          <label for="tags">{copy.tagsLabel}</label>
          <input id="tags" name="tags" type="text" />
          <p class="editor-hint">{copy.tagsHint}</p>
        </div>

        <div class="editor-section">
            <label for="content-locale">{copy.contentLocaleLabel}</label>

            <select id="content-locale" name="content_locale" required>
                <option value="zh-Hant">{copy.languageTraditional}</option>
                <option value="zh-Hans">{copy.languageSimplified}</option>
                <option value="en">{copy.languageEnglish}</option>
                <option value="ja">{copy.languageJapanese}</option>
            </select>

            <p class="editor-hint">{copy.contentLocaleHint}</p>
        </div>
      </section>

      <section class="editor-section">
        <div class="editor-content-heading">
          <label for="content">{copy.contentLabel}</label>

          <div
            class="editor-mode-switch"
            role="tablist"
            aria-label={copy.editorModeLabel}
            >
            <button
              class="editor-mode-button is-active"
              type="button"
              role="tab"
              aria-selected="true"
              data-editor-mode="write"
            >
             {copy.write}
            </button>

            <button
              class="editor-mode-button"
              type="button"
              role="tab"
              aria-selected="false"
              data-editor-mode="preview"
            >
              {copy.preview}
            </button>
          </div>
        </div>

        <textarea
          class="editor-content"
          id="content"
          name="content"
          rows="18"
          data-markdown-input
          required
        ></textarea>

        <div class="editor-preview" data-markdown-preview hidden></div>

        <p class="editor-hint">{copy.markdownHint}</p>
      </section>

      <div class="editor-actions">
        <p class="editor-message" data-editor-message aria-live="polite"></p>

        <div class="editor-button-group">
          <button class="editor-delete" type="button" data-delete>
            {copy.delete}
          </button>
          <button class="editor-save" type="submit" value="draft">
            {copy.saveDraft}
          </button>
          <button class="editor-publish" type="submit" value="published">
            {copy.publish} <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </form>

    <p class="studio-empty" data-load-error hidden></p>
  </main>

  <script>
  import { supabase } from "../../lib/supabase";
  import { renderMarkdown } from "../../lib/markdown";
  import { localizePath, type Locale } from "../i18n/config";
  import { studioCopy } from "../i18n/studio";

  type ContentLocale = "zh-Hant" | "zh-Hans" | "en" | "ja";

  type Post = {
    id: string;
    title: string;
    description: string;
    slug: string;
    content: string;
    tags: string[];
    status: "draft" | "published";
    published_at: string | null;
    content_locale: ContentLocale;
  };

  const page =
    document.querySelector<HTMLElement>("[data-studio-edit-page]");

  const locale = (page?.dataset.locale ?? "en") as Locale;
  const copy = studioCopy[locale];
  const studioPath = localizePath(locale, "/studio");

  const form = document.querySelector<HTMLFormElement>("[data-post-form]");
  const status = document.querySelector<HTMLParagraphElement>(
    "[data-editor-status]",
  );
  const message = document.querySelector<HTMLParagraphElement>(
    "[data-editor-message]",
  );
  const loadError = document.querySelector<HTMLParagraphElement>(
    "[data-load-error]",
  );
  const deleteButton =
    document.querySelector<HTMLButtonElement>("[data-delete]");
  const buttons = form?.querySelectorAll<HTMLButtonElement>("button");
  const markdownInput =
    document.querySelector<HTMLTextAreaElement>("[data-markdown-input]");
  const markdownPreview =
    document.querySelector<HTMLDivElement>("[data-markdown-preview]");
  const modeButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-editor-mode]");

  const setEditorMode = (mode: "write" | "preview") => {
    const isPreview = mode === "preview";

    if (markdownInput) markdownInput.hidden = isPreview;

    if (markdownPreview) {
      markdownPreview.hidden = !isPreview;

      if (isPreview) {
        markdownPreview.innerHTML = renderMarkdown(
          markdownInput?.value || copy.emptyPreview,
        );
      }
    }

    modeButtons.forEach((button) => {
      const isActive = button.dataset.editorMode === mode;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-selected", String(isActive));
    });
  };

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.editorMode;

      if (mode === "write" || mode === "preview") {
        setEditorMode(mode);
      }
    });
  });

  const id = new URLSearchParams(window.location.search).get("id");
  const slugPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
  const contentLocales = ["zh-Hant", "zh-Hans", "en", "ja"] as const;

  const isContentLocale = (value: string): value is ContentLocale =>
    contentLocales.includes(value as ContentLocale);

  let currentPost: Post | null = null;

  const showLoadError = (text: string) => {
    if (status) status.textContent = copy.cannotOpen;

    if (loadError) {
      loadError.textContent = text;
      loadError.hidden = false;
    }
  };

  const fillForm = (post: Post) => {
    const fields = {
      title: post.title,
      description: post.description,
      slug: post.slug,
      tags: post.tags.join(", "),
      content: post.content,
      content_locale: post.content_locale,
    };

    Object.entries(fields).forEach(([name, value]) => {
      const field = form?.elements.namedItem(name);

      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        field.value = value;
      }
    });

    if (status) {
      status.textContent =
        post.status === "published"
          ? copy.publishedStatus
          : copy.draftStatus;
    }

    form?.removeAttribute("hidden");
  };

  const loadPost = async () => {
    const {
      data: { user },
    } = await supabase.auth.getUser();

    if (!user) {
      window.location.replace("/login");
      return;
    }

    if (!id) {
      showLoadError(copy.missingId);
      return;
    }

    const { data, error } = await supabase
      .from("posts")
      .select(
        "id, title, description, slug, content, tags, status, published_at, content_locale",
      )
      .eq("id", id)
      .single();

    if (error || !data) {
      showLoadError(copy.notFound);
      return;
    }

    currentPost = data as Post;
    fillForm(currentPost);
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const post = currentPost;

    if (!post) return;

    const submitter = event.submitter as HTMLButtonElement | null;
    const action =
      submitter?.value === "published" ? "published" : "draft";
    const formData = new FormData(form);

    const title = String(formData.get("title") || "").trim();
    const description = String(formData.get("description") || "").trim();
    const slug = String(formData.get("slug") || "")
      .trim()
      .toLowerCase();
    const content = String(formData.get("content") || "").trim();
    const contentLocale = String(
      formData.get("content_locale") || "zh-Hant",
    );

    const tags = String(formData.get("tags") || "")
      .split(/[,，]/)
      .map((tag) => tag.trim())
      .filter(Boolean);

    if (!slugPattern.test(slug)) {
      if (message) message.textContent = copy.invalidSlug;
      return;
    }

    if (!isContentLocale(contentLocale)) {
      if (message) message.textContent = copy.invalidLocale;
      return;
    }

    if (!title || !description || !content) {
      if (message) message.textContent = copy.requiredFields;
      return;
    }

    buttons?.forEach((button) => {
      button.disabled = true;
    });

    if (message) {
      message.textContent =
        action === "published"
          ? copy.publishing
          : copy.savingDraft;
    }

    const { error } = await supabase
      .from("posts")
      .update({
        title,
        description,
        slug,
        content,
        content_locale: contentLocale,
        tags,
        status: action,
        published_at:
          action === "published"
            ? post.published_at || new Date().toISOString()
            : null,
      })
      .eq("id", post.id);

    if (error) {
      if (message) {
        message.textContent =
          error.code === "23505"
            ? copy.duplicateSlug
            : copy.saveError(error.message);
      }

      buttons?.forEach((button) => {
        button.disabled = false;
      });

      return;
    }

    window.location.assign(studioPath);
  });

  deleteButton?.addEventListener("click", async () => {
    const post = currentPost;

    if (!post) return;

    const confirmed = window.confirm(copy.deleteConfirm(post.title));

    if (!confirmed) return;

    deleteButton.disabled = true;

    const { error } = await supabase
      .from("posts")
      .delete()
      .eq("id", post.id);

    if (error) {
      if (message) {
        message.textContent = copy.deleteError(error.message);
      }

      deleteButton.disabled = false;
      return;
    }

    window.location.assign(studioPath);
  });

  loadPost();
</script>
</BaseLayout>